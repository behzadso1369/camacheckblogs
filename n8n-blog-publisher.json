{
  "name": "CarmaCheck Blog Publisher (Scheduled)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "hours", "hoursInterval": 2 }
          ]
        }
      },
      "id": "trigger-schedule",
      "name": "هر ۲ ساعت",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-1360, 400],
      "notes": "هر ۲ ساعت یک‌بار اجرا می‌شود و بلاگ منتشرنشده بعدی را پابلیش می‌کند."
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "a1", "name": "apiBase", "value": "https://api.carmacheck.com/api/admin/", "type": "string" },
            { "id": "a2", "name": "userName", "value": "USERNAME_HERE", "type": "string" },
            { "id": "a3", "name": "password", "value": "PASSWORD_HERE", "type": "string" },
            { "id": "a4", "name": "blogsRoot", "value": "/data/blogs", "type": "string" },
            { "id": "a6", "name": "fileServeBase", "value": "https://api.carmacheck.com/", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "cfg",
      "name": "تنظیمات (Config)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-1140, 400],
      "notes": "blogsRoot = مسیر داخل کانتینر داکر (پوشه blogs که mount کردی). یوزر/پس از Environment Variables."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.apiBase }}Auth/login",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"UserName\": \"{{ $json.userName }}\",\n  \"Password\": \"{{ $json.password }}\"\n}",
        "options": {}
      },
      "id": "login",
      "name": "لاگین → توکن",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-920, 400],
      "notes": "پاسخ: resultObject.accessToken"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "t1", "name": "accessToken", "value": "={{ $json.resultObject.accessToken }}", "type": "string" },
            { "id": "t2", "name": "apiBase", "value": "={{ $('تنظیمات (Config)').item.json.apiBase }}", "type": "string" },
            { "id": "t3", "name": "blogsRoot", "value": "={{ $('تنظیمات (Config)').item.json.blogsRoot }}", "type": "string" },
            { "id": "t5", "name": "fileServeBase", "value": "={{ $('تنظیمات (Config)').item.json.fileServeBase }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "token",
      "name": "نگهداری توکن",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-700, 400]
    },
    {
      "parameters": {
        "jsCode": "// بلاگ منتشرنشده بعدی را انتخاب می‌کند:\n// شرط: index.html + meta.json + حداقل یک عکس دارد و هنوز فایل .published ندارد.\nconst fs = require('fs');\nconst path = require('path');\nconst cfg = $json;\nconst root = cfg.blogsRoot;\nlet dirs = [];\ntry { dirs = fs.readdirSync(root, { withFileTypes: true }).filter(d => d.isDirectory()).map(d => d.name); } catch (e) { throw new Error('blogsRoot خوانده نشد: ' + root); }\nfor (const slug of dirs.sort()) {\n  const base = path.join(root, slug);\n  const hasHtml = fs.existsSync(path.join(base, 'index.html'));\n  const hasMeta = fs.existsSync(path.join(base, 'meta.json'));\n  const published = fs.existsSync(path.join(base, '.published'));\n  let imgs = [];\n  try { imgs = fs.readdirSync(path.join(base, 'images')).filter(f => /\\.(jpg|jpeg|png|webp)$/i.test(f)); } catch (e) {}\n  if (hasHtml && hasMeta && imgs.length > 0 && !published) {\n    return [{ json: { ...cfg, blogSlug: slug } }];\n  }\n}\n// چیزی برای انتشار نمانده → خروجی خالی، اجرا اینجا متوقف می‌شود\nreturn [];"
      },
      "id": "pick-blog",
      "name": "انتخاب بلاگ بعدی",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-480, 400],
      "notes": "اگر همه بلاگ‌ها منتشر شده باشند، خروجی خالی می‌دهد و جریان متوقف می‌شود."
    },
    {
      "parameters": {
        "fileSelector": "={{ $json.blogsRoot }}/{{ $json.blogSlug }}/meta.json",
        "options": {}
      },
      "id": "read-meta",
      "name": "خواندن meta.json",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [-260, 400]
    },
    {
      "parameters": { "operation": "fromJson", "options": {} },
      "id": "meta-parse",
      "name": "meta → JSON",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [-40, 400]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "m0", "name": "meta", "value": "={{ $json.data }}", "type": "object" },
            { "id": "m1", "name": "accessToken", "value": "={{ $('نگهداری توکن').item.json.accessToken }}", "type": "string" },
            { "id": "m2", "name": "apiBase", "value": "={{ $('نگهداری توکن').item.json.apiBase }}", "type": "string" },
            { "id": "m3", "name": "blogsRoot", "value": "={{ $('نگهداری توکن').item.json.blogsRoot }}", "type": "string" },
            { "id": "m4", "name": "blogSlug", "value": "={{ $('انتخاب بلاگ بعدی').item.json.blogSlug }}", "type": "string" },
            { "id": "m5", "name": "fileServeBase", "value": "={{ $('نگهداری توکن').item.json.fileServeBase }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "ctx",
      "name": "کانتکست کامل",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [180, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.apiBase }}FileManager/CreateFolder?parentPath=&name={{ $json.blogSlug }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $json.accessToken }}" },
            { "name": "accept", "value": "application/json" }
          ]
        },
        "options": {}
      },
      "id": "create-folder",
      "name": "ساخت پوشه بلاگ",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [400, 400],
      "notes": "FileManager/CreateFolder?parentPath=&name=<slug>  — بدنه ندارد"
    },
    {
      "parameters": {
        "jsCode": "const fs = require('fs');\nconst path = require('path');\nconst ctx = $('کانتکست کامل').item.json;\nconst imgDir = path.join(ctx.blogsRoot, ctx.blogSlug, 'images');\nlet files = [];\ntry { files = fs.readdirSync(imgDir).filter(f => /\\.(jpg|jpeg|png|webp)$/i.test(f)); } catch (e) {}\nreturn files.map(f => ({ json: {\n  fileName: f,\n  filePath: path.join(imgDir, f),\n  blogSlug: ctx.blogSlug,\n  apiBase: ctx.apiBase,\n  accessToken: ctx.accessToken\n}}));"
      },
      "id": "list-images",
      "name": "لیست عکس‌ها",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [620, 400]
    },
    {
      "parameters": {
        "fileSelector": "={{ $json.filePath }}",
        "options": { "dataPropertyName": "data" }
      },
      "id": "read-image",
      "name": "خواندن فایل عکس",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [840, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('لیست عکس‌ها').item.json.apiBase }}FileManager/upload",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $('لیست عکس‌ها').item.json.accessToken }}" },
            { "name": "accept", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            { "parameterType": "formBinaryData", "name": "file", "inputDataFieldName": "data" },
            { "name": "path", "value": "={{ $('لیست عکس‌ها').item.json.blogSlug }}" }
          ]
        },
        "options": {}
      },
      "id": "upload-image",
      "name": "آپلود عکس",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1060, 400],
      "notes": "FileManager/upload — فرم‌دیتا: file + path=<slug>"
    },
    {
      "parameters": { "maxItems": 1 },
      "id": "limit-one",
      "name": "بعد از آپلود همه → یک شاخه",
      "type": "n8n-nodes-base.limit",
      "typeVersion": 1,
      "position": [1280, 400],
      "notes": "تا مرحله ساخت بلاگ فقط یک‌بار اجرا شود (نه به‌ازای هر عکس)."
    },
    {
      "parameters": {
        "fileSelector": "={{ $('کانتکست کامل').item.json.blogsRoot }}/{{ $('کانتکست کامل').item.json.blogSlug }}/index.html",
        "options": { "dataPropertyName": "htmlData" }
      },
      "id": "read-html",
      "name": "خواندن index.html",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [1500, 400]
    },
    {
      "parameters": {
        "operation": "binaryToPropery",
        "binaryPropertyName": "htmlData",
        "options": {}
      },
      "id": "html-to-text",
      "name": "HTML → متن",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [1720, 400]
    },
    {
      "parameters": {
        "jsCode": "// بدنه <article> را به‌عنوان Content برمی‌دارد و مسیر عکس‌ها را به آدرس سرور بازنویسی می‌کند\nconst ctx = $('کانتکست کامل').item.json;\nconst meta = ctx.meta;\nlet html = $input.item.json.data || '';\nconst m = html.match(/<article[^>]*>([\\s\\S]*?)<\\/article>/i);\nlet content = m ? m[1] : html;\nconst serveBase = ctx.fileServeBase.replace(/\\/$/, '');\ncontent = content.replace(/src=\"images\\/([^\"]+)\"/g, `src=\"${serveBase}/${ctx.blogSlug}/$1\"`);\nreturn [{ json: {\n  ...meta,\n  Content: content,\n  apiBase: ctx.apiBase,\n  accessToken: ctx.accessToken,\n  blogSlug: ctx.blogSlug,\n  blogsRoot: ctx.blogsRoot\n}}];"
      },
      "id": "build-content",
      "name": "ساخت Content + بازنویسی عکس",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1940, 400]
    },
    {
      "parameters": {
        "jsCode": "// اولین فایلی که با hero شروع می‌شود = تصویر شاخص\nconst fs = require('fs');\nconst path = require('path');\nconst j = $input.item.json;\nconst imgDir = path.join(j.blogsRoot, j.blogSlug, 'images');\nlet files = [];\ntry { files = fs.readdirSync(imgDir); } catch(e) {}\nconst hero = files.find(f => /^hero/i.test(f)) || files[0];\nreturn [{ json: { ...j, heroPath: path.join(imgDir, hero || '') } }];"
      },
      "id": "pick-hero",
      "name": "انتخاب تصویر شاخص",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2160, 400]
    },
    {
      "parameters": {
        "fileSelector": "={{ $json.heroPath }}",
        "options": { "dataPropertyName": "heroImage" }
      },
      "id": "read-hero",
      "name": "خواندن تصویر شاخص",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [2380, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('ساخت Content + بازنویسی عکس').item.json.apiBase }}BlogPost/CreateWithFile",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $('ساخت Content + بازنویسی عکس').item.json.accessToken }}" },
            { "name": "accept", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            { "name": "Title", "value": "={{ $('ساخت Content + بازنویسی عکس').item.json.Title }}" },
            { "name": "CategoryId", "value": "={{ $('ساخت Content + بازنویسی عکس').item.json.CategoryId }}" },
            { "name": "Content", "value": "={{ $('ساخت Content + بازنویسی عکس').item.json.Content }}" },
            { "name": "Excerpt", "value": "={{ $('ساخت Content + بازنویسی عکس').item.json.Excerpt }}" },
            { "name": "IsPublished", "value": "={{ $('ساخت Content + بازنویسی عکس').item.json.IsPublished }}" },
            { "name": "IsFirstPage", "value": "={{ $('ساخت Content + بازنویسی عکس').item.json.IsFirstPage }}" },
            { "name": "Slug", "value": "={{ $('ساخت Content + بازنویسی عکس').item.json.Slug }}" },
            { "name": "blogPostTitle", "value": "={{ $('ساخت Content + بازنویسی عکس').item.json.blogPostTitle }}" },
            { "name": "blogPostDescription", "value": "={{ $('ساخت Content + بازنویسی عکس').item.json.blogPostDescription }}" },
            { "name": "blogPostKeyword", "value": "={{ $('ساخت Content + بازنویسی عکس').item.json.blogPostKeyword }}" },
            { "name": "blogPostCanonical", "value": "={{ $('ساخت Content + بازنویسی عکس').item.json.blogPostCanonical }}" },
            { "parameterType": "formBinaryData", "name": "Image", "inputDataFieldName": "heroImage" }
          ]
        },
        "options": {}
      },
      "id": "create-blogpost",
      "name": "ساخت بلاگ‌پست",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2600, 400],
      "notes": "BlogPost/CreateWithFile — فیلدهای سئو جداگانه + تصویر شاخص"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://indexing.googleapis.com/v3/urlNotifications:publish",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"url\": \"{{ $('ساخت Content + بازنویسی عکس').item.json.blogPostCanonical }}\",\n  \"type\": \"URL_UPDATED\"\n}",
        "options": {}
      },
      "id": "index-google",
      "name": "ثبت در Google Index",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2820, 400],
      "notes": "Google Indexing API — نیازمند Service Account با دسترسی Search Console. نداشتی، این نود را غیرفعال کن (اتصالش به نود بعد را نگه دار)."
    },
    {
      "parameters": {
        "jsCode": "// بلاگ را منتشرشده علامت می‌زند تا در اجراهای بعدی دوباره انتخاب نشود\nconst fs = require('fs');\nconst path = require('path');\nconst j = $('کانتکست کامل').item.json;\nconst marker = path.join(j.blogsRoot, j.blogSlug, '.published');\nfs.writeFileSync(marker, new Date().toISOString());\nreturn [{ json: { publishedBlog: j.blogSlug, at: new Date().toISOString() } }];"
      },
      "id": "mark-published",
      "name": "علامت‌گذاری منتشر شد",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3040, 400],
      "notes": "فایل .published داخل پوشه بلاگ می‌سازد تا اجرای بعدی سراغ بلاگ جدید برود."
    }
  ],
  "connections": {
    "هر ۲ ساعت": { "main": [[{ "node": "تنظیمات (Config)", "type": "main", "index": 0 }]] },
    "تنظیمات (Config)": { "main": [[{ "node": "لاگین → توکن", "type": "main", "index": 0 }]] },
