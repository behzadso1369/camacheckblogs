    "ساخت Content + بازنویسی عکس": { "main": [[{ "node": "انتخاب تصویر شاخص", "type": "main", "index": 0 }]] },
    "انتخاب تصویر شاخص": { "main": [[{ "node": "خواندن تصویر شاخص", "type": "main", "index": 0 }]] },
    "خواندن تصویر شاخص": { "main": [[{ "node": "ساخت بلاگ‌پست", "type": "main", "index": 0 }]] },
    "ساخت بلاگ‌پست": { "main": [[{ "node": "ثبت در Google Index", "type": "main", "index": 0 }]] },
    "ثبت در Google Index": { "main": [[{ "node": "علامت‌گذاری منتشر شد", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
