{
  "name": "CarmaCheck Blog Publisher (Git/Scheduled)",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [ { "field": "hours", "hoursInterval": 2 } ] }
      },
      "id": "trigger-schedule",
      "name": "هر ۲ ساعت",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-1600, 400]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "a1", "name": "apiBase", "value": "https://api.carmacheck.com/api/admin/", "type": "string" },
            { "id": "a2", "name": "userName", "value": "USERNAME_HERE", "type": "string" },
            { "id": "a3", "name": "password", "value": "PASSWORD_HERE", "type": "string" },
            { "id": "a4", "name": "ghOwner", "value": "behzadso1369", "type": "string" },
            { "id": "a5", "name": "ghRepo", "value": "camacheckblogs", "type": "string" },
            { "id": "a6", "name": "ghBranch", "value": "main", "type": "string" },
            { "id": "a7", "name": "fileServeBase", "value": "https://api.carmacheck.com/", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "cfg",
      "name": "تنظیمات (Config)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-1400, 400],
      "notes": "USERNAME_HERE/PASSWORD_HERE را با یوزر/پس داشبورد عوض کن. مخزن گیت عمومی."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.apiBase }}Auth/login",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"UserName\": \"{{ $json.userName }}\",\n  \"Password\": \"{{ $json.password }}\"\n}",
        "options": {}
      },
      "id": "login",
      "name": "لاگین → توکن",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-1200, 400]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "t1", "name": "accessToken", "value": "={{ $json.resultObject.accessToken }}", "type": "string" },
            { "id": "t2", "name": "apiBase", "value": "={{ $('تنظیمات (Config)').item.json.apiBase }}", "type": "string" },
            { "id": "t3", "name": "ghOwner", "value": "={{ $('تنظیمات (Config)').item.json.ghOwner }}", "type": "string" },
            { "id": "t4", "name": "ghRepo", "value": "={{ $('تنظیمات (Config)').item.json.ghRepo }}", "type": "string" },
            { "id": "t5", "name": "ghBranch", "value": "={{ $('تنظیمات (Config)').item.json.ghBranch }}", "type": "string" },
            { "id": "t6", "name": "fileServeBase", "value": "={{ $('تنظیمات (Config)').item.json.fileServeBase }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "token",
      "name": "نگهداری توکن",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-1000, 400]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.apiBase }}BlogPost/List",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "skip", "value": "0" },
            { "name": "take", "value": "10000" }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $json.accessToken }}" },
            { "name": "accept", "value": "application/json" }
          ]
        },
        "options": {}
      },
      "id": "get-published",
      "name": "لیست بلاگ‌های منتشرشده",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-800, 400],
      "notes": "برای تشخیص اینکه کدام اسلاگ‌ها قبلاً منتشر شده‌اند."
    },
    {
      "parameters": {
        "jsCode": "// اسلاگ‌های منتشرشده را به‌صورت آرایه بیرون می‌دهد (منبع حقیقت به‌جای فایل .published)\nconst list = ($json.resultObject) || [];\nconst slugs = list.map(x => (x.Slug || x.slug)).filter(Boolean);\nreturn [{ json: { publishedSlugs: slugs } }];"
      },
      "id": "extract-slugs",
      "name": "اسلاگ‌های منتشرشده",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-600, 400]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $('نگهداری توکن').item.json.ghOwner }}/{{ $('نگهداری توکن').item.json.ghRepo }}/git/trees/{{ $('نگهداری توکن').item.json.ghBranch }}?recursive=1",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "accept", "value": "application/vnd.github+json" },
            { "name": "User-Agent", "value": "n8n-carmacheck" }
          ]
        },
        "options": {}
      },
      "id": "get-folders",
      "name": "درخت کامل مخزن گیت",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-400, 400],
      "notes": "GitHub Git Trees API با recursive=1 — کل درخت مخزن در یک درخواست."
    },
    {
      "parameters": {
        "jsCode": "// از درخت کامل مخزن، اولین بلاگی که index.html + meta.json + حداقل یک عکس دارد و منتشر نشده را انتخاب می‌کند\nconst j = $input.first().json;\nconst tree = (j.tree) || [];\nconst published = ($('اسلاگ‌های منتشرشده').first().json.publishedSlugs) || [];\nconst tk = $('نگهداری توکن').first().json;\nconst imgRe = /\\.(jpg|jpeg|png|webp)$/i;\nconst slugs = {};\nfor (const e of tree) {\n  const parts = String(e.path).split('/');\n  const slug = parts[0];\n  if (!slug || slug.startsWith('.')) continue;\n  if (!slugs[slug]) slugs[slug] = { html: false, meta: false, img: false };\n  if (parts.length === 2 && parts[1] === 'index.html') slugs[slug].html = true;\n  if (parts.length === 2 && parts[1] === 'meta.json') slugs[slug].meta = true;\n  if (parts.length === 3 && parts[1] === 'images' && e.type === 'blob' && imgRe.test(parts[2])) slugs[slug].img = true;\n}\nconst eligible = Object.keys(slugs)\n  .filter(s => slugs[s].html && slugs[s].meta && slugs[s].img && !published.includes(s))\n  .sort();\nif (eligible.length === 0) return [];\nreturn [{ json: {\n  blogSlug: eligible[0],\n  accessToken: tk.accessToken,\n  apiBase: tk.apiBase,\n  ghOwner: tk.ghOwner,\n  ghRepo: tk.ghRepo,\n  ghBranch: tk.ghBranch,\n  fileServeBase: tk.fileServeBase\n}}];"
      },
      "id": "pick-blog",
      "name": "انتخاب بلاگ بعدی",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-200, 400]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://raw.githubusercontent.com/{{ $json.ghOwner }}/{{ $json.ghRepo }}/{{ $json.ghBranch }}/{{ $json.blogSlug }}/meta.json",
        "options": {}
      },
      "id": "fetch-meta",
      "name": "خواندن meta.json",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [0, 400]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "c0", "name": "meta", "value": "={{ $json }}", "type": "object" },
            { "id": "c1", "name": "blogSlug", "value": "={{ $('انتخاب بلاگ بعدی').item.json.blogSlug }}", "type": "string" },
            { "id": "c2", "name": "accessToken", "value": "={{ $('انتخاب بلاگ بعدی').item.json.accessToken }}", "type": "string" },
            { "id": "c3", "name": "apiBase", "value": "={{ $('انتخاب بلاگ بعدی').item.json.apiBase }}", "type": "string" },
            { "id": "c4", "name": "ghOwner", "value": "={{ $('انتخاب بلاگ بعدی').item.json.ghOwner }}", "type": "string" },
            { "id": "c5", "name": "ghRepo", "value": "={{ $('انتخاب بلاگ بعدی').item.json.ghRepo }}", "type": "string" },
            { "id": "c6", "name": "ghBranch", "value": "={{ $('انتخاب بلاگ بعدی').item.json.ghBranch }}", "type": "string" },
            { "id": "c7", "name": "fileServeBase", "value": "={{ $('انتخاب بلاگ بعدی').item.json.fileServeBase }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "ctx",
      "name": "کانتکست کامل",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [200, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.apiBase }}FileManager/CreateFolder?parentPath=&name={{ $json.blogSlug }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $json.accessToken }}" },
            { "name": "accept", "value": "application/json" }
          ]
        },
        "options": {}
      },
      "id": "create-folder",
      "name": "ساخت پوشه بلاگ",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [400, 400]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $('کانتکست کامل').item.json.ghOwner }}/{{ $('کانتکست کامل').item.json.ghRepo }}/contents/{{ $('کانتکست کامل').item.json.blogSlug }}/images?ref={{ $('کانتکست کامل').item.json.ghBranch }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "accept", "value": "application/vnd.github+json" },
            { "name": "User-Agent", "value": "n8n-carmacheck" }
          ]
        },
        "options": {}
      },
      "id": "list-images",
      "name": "لیست عکس‌ها (گیت)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [600, 400],
      "notes": "هر عکس یک آیتم با name + download_url"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.download_url }}",
        "options": { "response": { "response": { "responseFormat": "file", "outputPropertyName": "data" } } }
      },
      "id": "download-image",
      "name": "دانلود عکس از گیت",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [800, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('کانتکست کامل').item.json.apiBase }}FileManager/upload",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $('کانتکست کامل').item.json.accessToken }}" },
            { "name": "accept", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            { "parameterType": "formBinaryData", "name": "file", "inputDataFieldName": "data" },
            { "name": "path", "value": "={{ $('کانتکست کامل').item.json.blogSlug }}" }
          ]
        },
        "options": {}
      },
      "id": "upload-image",
      "name": "آپلود عکس",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1000, 400]
    },
    {
      "parameters": { "maxItems": 1 },
      "id": "limit-one",
      "name": "بعد از آپلود همه → یک شاخه",
      "type": "n8n-nodes-base.limit",
      "typeVersion": 1,
      "position": [1200, 400]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://raw.githubusercontent.com/{{ $('کانتکست کامل').item.json.ghOwner }}/{{ $('کانتکست کامل').item.json.ghRepo }}/{{ $('کانتکست کامل').item.json.ghBranch }}/{{ $('کانتکست کامل').item.json.blogSlug }}/index.html",
        "options": { "response": { "response": { "responseFormat": "text", "outputPropertyName": "data" } } }
      },
      "id": "fetch-html",
      "name": "خواندن index.html",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1400, 400]
    },
    {
      "parameters": {
        "jsCode": "// بدنه <article> را برمی‌دارد و مسیر عکس‌ها را به آدرس سرور بازنویسی می‌کند\nconst ctx = $('کانتکست کامل').item.json;\nconst meta = ctx.meta;\nlet html = $input.item.json.data || '';\nconst m = html.match(/<article[^>]*>([\\s\\S]*?)<\\/article>/i);\nlet content = m ? m[1] : html;\nconst serveBase = String(ctx.fileServeBase).replace(/\\/$/, '');\ncontent = content.replace(/src=\"images\\/([^\"]+)\"/g, `src=\"${serveBase}/${ctx.blogSlug}/$1\"`);\nreturn [{ json: {\n  ...meta,\n  Content: content,\n  apiBase: ctx.apiBase,\n  accessToken: ctx.accessToken,\n  blogSlug: ctx.blogSlug\n}}];"
      },
      "id": "build-content",
      "name": "ساخت Content + بازنویسی عکس",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1600, 400]
    },
    {
      "parameters": {
        "jsCode": "// تصویر شاخص = فایلی که با hero شروع می‌شود (یا اولین عکس)\nconst imgs = $('لیست عکس‌ها (گیت)').all().map(i => i.json);\nconst hero = imgs.find(x => /^hero/i.test(x.name)) || imgs[0];\nconst j = $input.item.json;\nreturn [{ json: { ...j, heroUrl: hero ? hero.download_url : '' } }];"
      },
      "id": "pick-hero",
      "name": "انتخاب تصویر شاخص",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1800, 400]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.heroUrl }}",
        "options": { "response": { "response": { "responseFormat": "file", "outputPropertyName": "heroImage" } } }
      },
      "id": "download-hero",
      "name": "دانلود تصویر شاخص",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2000, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('ساخت Content + بازنویسی عکس').item.json.apiBase }}BlogPost/CreateWithFile",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $('ساخت Content + بازنویسی عکس').item.json.accessToken }}" },
            { "name": "accept", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            { "name": "Title", "value": "={{ $('ساخت Content + بازنویسی عکس').item.json.Title }}" },
            { "name": "CategoryId", "value": "={{ $('ساخت Content + بازنویسی عکس').item.json.CategoryId }}" },
            { "name": "Content", "value": "={{ $('ساخت Content + بازنویسی عکس').item.json.Content }}" },
            { "name": "Excerpt", "value": "={{ $('ساخت Content + بازنویسی عکس').item.json.Excerpt }}" },
            { "name": "IsPublished", "value": "={{ $('ساخت Content + بازنویسی عکس').item.json.IsPublished }}" },
            { "name": "IsFirstPage", "value": "={{ $('ساخت Content + بازنویسی عکس').item.json.IsFirstPage }}" },
            { "name": "Slug", "value": "={{ $('ساخت Content + بازنویسی عکس').item.json.Slug }}" },
            { "name": "blogPostTitle", "value": "={{ $('ساخت Content + بازنویسی عکس').item.json.blogPostTitle }}" },
            { "name": "blogPostDescription", "value": "={{ $('ساخت Content + بازنویسی عکس').item.json.blogPostDescription }}" },
            { "name": "blogPostKeyword", "value": "={{ $('ساخت Content + بازنویسی عکس').item.json.blogPostKeyword }}" },
            { "name": "blogPostCanonical", "value": "={{ $('ساخت Content + بازنویسی عکس').item.json.blogPostCanonical }}" },
            { "parameterType": "formBinaryData", "name": "Image", "inputDataFieldName": "heroImage" }
          ]
        },
        "options": {}
      },
      "id": "create-blogpost",
      "name": "ساخت بلاگ‌پست",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2200, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://indexing.googleapis.com/v3/urlNotifications:publish",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"url\": \"{{ $('ساخت Content + بازنویسی عکس').item.json.blogPostCanonical }}\",\n  \"type\": \"URL_UPDATED\"\n}",
        "options": {}
      },
      "id": "index-google",
      "name": "ثبت در Google Index",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2400, 400],
      "notes": "Google Indexing API — نیازمند Service Account با دسترسی Search Console. نداشتی، Disable کن."
    }
  ],
  "connections": {
    "هر ۲ ساعت": { "main": [[{ "node": "تنظیمات (Config)", "type": "main", "index": 0 }]] },
    "تنظیمات (Config)": { "main": [[{ "node": "لاگین → توکن", "type": "main", "index": 0 }]] },
    "لاگین → توکن": { "main": [[{ "node": "نگهداری توکن", "type": "main", "index": 0 }]] },
    "نگهداری توکن": { "main": [[{ "node": "لیست بلاگ‌های منتشرشده", "type": "main", "index": 0 }]] },
    "لیست بلاگ‌های منتشرشده": { "main": [[{ "node": "اسلاگ‌های منتشرشده", "type": "main", "index": 0 }]] },
    "اسلاگ‌های منتشرشده": { "main": [[{ "node": "لیست پوشه‌های گیت", "type": "main", "index": 0 }]] },
    "لیست پوشه‌های گیت": { "main": [[{ "node": "انتخاب بلاگ بعدی", "type": "main", "index": 0 }]] },
    "انتخاب بلاگ بعدی": { "main": [[{ "node": "خواندن meta.json", "type": "main", "index": 0 }]] },
    "خواندن meta.json": { "main": [[{ "node": "کانتکست کامل", "type": "main", "index": 0 }]] },
    "کانتکست کامل": { "main": [[{ "node": "ساخت پوشه بلاگ", "type": "main", "index": 0 }]] },
    "ساخت پوشه بلاگ": { "main": [[{ "node": "لیست عکس‌ها (گیت)", "type": "main", "index": 0 }]] },
    "لیست عکس‌ها (گیت)": { "main": [[{ "node": "دانلود عکس از گیت", "type": "main", "index": 0 }]] },
    "دانلود عکس از گیت": { "main": [[{ "node": "آپلود عکس", "type": "main", "index": 0 }]] },
    "آپلود عکس": { "main": [[{ "node": "بعد از آپلود همه → یک شاخه", "type": "main", "index": 0 }]] },
    "بعد از آپلود همه → یک شاخه": { "main": [[{ "node": "خواندن index.html", "type": "main", "index": 0 }]] },
    "خواندن index.html": { "main": [[{ "node": "ساخت Content + بازنویسی عکس", "type": "main", "index": 0 }]] },
    "ساخت Content + بازنویسی عکس": { "main": [[{ "node": "انتخاب تصویر شاخص", "type": "main", "index": 0 }]] },
    "انتخاب تصویر شاخص": { "main": [[{ "node": "دانلود تصویر شاخص", "type": "main", "index": 0 }]] },
    "دانلود تصویر شاخص": { "main": [[{ "node": "ساخت بلاگ‌پست", "type": "main", "index": 0 }]] },
    "ساخت بلاگ‌پست": { "main": [[{ "node": "ثبت در Google Index", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
